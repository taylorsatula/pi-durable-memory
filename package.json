{
  "name": "@taylorsatula/pi-durable-memory",
  "version": "0.4.1",
  "description": "Persistent long-term memory for pi: remembers what your agent learned across sessions, recalls the right facts automatically at the start of each task, and stores them locally in SQLite (searched by meaning, not keywords, with optional encryption).",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "sqlite",
    "embeddings",
    "encryption"
  ],
  "license": "MIT",
  "author": "Taylor Satula",
  "type": "module",
  "scripts": {
    "test": "node bench/probe.mjs",
    "prepublishOnly": "node bench/probe.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorsatula/pi-durable-memory.git"
  },
  "bugs": {
    "url": "https://github.com/taylorsatula/pi-durable-memory/issues"
  },
  "homepage": "https://github.com/taylorsatula/pi-durable-memory#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
